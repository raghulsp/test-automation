<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress Apache HttpClient wire/header logging -->
    <logger name="org.apache.hc.client5.http.wire"   level="OFF"/>
    <logger name="org.apache.hc.client5.http.headers" level="OFF"/>
    <logger name="org.apache.hc.client5"              level="WARN"/>

    <!-- Suppress Selenium/WebDriver internal noise -->
    <logger name="org.openqa.selenium"                level="WARN"/>

    <!-- Suppress WebDriverManager download logs -->
    <logger name="io.github.bonigarcia"               level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>