<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Automation Suite
  ─────────────────────────────────────────────────────────────────────────────
  Run all tests:
    mvn clean test

  Run only API tests (no browser required):
    mvn clean test -Dcucumber.filter.tags="@api"

  Run only integration tests (API setup + UI verification):
    mvn clean test -Dplatform=web -Dcucumber.filter.tags="@integration"

  Run only UI tests (exclude API-only scenarios):
    mvn clean test -Dplatform=web -Dcucumber.filter.tags="not @api and not @wip"

  Run smoke suite across all categories:
    mvn clean test -Dcucumber.filter.tags="@smoke"
  ─────────────────────────────────────────────────────────────────────────────
-->
<suite name="Automation Suite" verbose="1" parallel="methods" thread-count="5">

    <test name="All Tests">
        <classes>
            <class name="com.framework.runners.TestRunner"/>
        </classes>
    </test>

</suite>
